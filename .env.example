# Copy to .env at the repo root. Never commit .env (NFR-06).

# API
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS in development (Vite dev server).
# In the demo build the SPA is served by the API itself, so this can be empty.
CORS_ORIGINS=http://localhost:5173

# Database. The API connects as the low-privilege app role; migrations run as the owner role.
DATABASE_URL=postgres://secureshelf_app:app_dev_password@localhost:5432/secureshelf
MIGRATOR_DATABASE_URL=postgres://secureshelf_migrator:migrator_dev_password@localhost:5432/secureshelf
TEST_DATABASE_URL=postgres://secureshelf_app:app_dev_password@localhost:5432/secureshelf_test
TEST_MIGRATOR_DATABASE_URL=postgres://secureshelf_migrator:migrator_dev_password@localhost:5432/secureshelf_test

# Secrets. Generate real values with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=replace-me-with-32-random-bytes-base64
JWT_REFRESH_SECRET=replace-me-with-32-random-bytes-base64
# AES-256-GCM key for NIC / phone / contact fields and TOTP secrets (NFR-05). Exactly 32 bytes, base64.
FIELD_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# Evidence files live outside any static directory (proposal §4).
STORAGE_DIR=./storage
